# Categorical associations: Cramer's V
print("\n=== 7. CATEGORICAL ASSOCIATIONS (CRAMER'S V) ===")
from scipy.stats import chi2_contingency
def cramers_v(x, y):
    tab = pd.crosstab(x.fillna("<MISSING>").astype(str), y.fillna("<MISSING>").astype(str))
    if min(tab.shape) < 2: return np.nan
    chi2 = chi2_contingency(tab, correction=False)[0]
    n = tab.to_numpy().sum(); r, k = tab.shape
    phi2 = chi2/n
    # Bias-corrected Cramer's V
    phi2_corr = max(0, phi2 - ((k-1)*(r-1))/max(n-1, 1))
    r_corr = r - (r-1)**2/max(n-1, 1)
    k_corr = k - (k-1)**2/max(n-1, 1)
    denom = min(k_corr-1, r_corr-1)
    return np.sqrt(phi2_corr/denom) if denom > 0 else np.nan

