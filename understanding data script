import matplotlib
matplotlib.use("Agg")  # no windows pop up, everything goes to the PDF

import sys, atexit, textwrap
from pathlib import Path
import matplotlib.pyplot as plt
from matplotlib.backends.backend_pdf import PdfPages

PDF_PATH = Path(r"C:\Users\Omars\Downloads\hotel_eda_report.pdf")
_pdf = PdfPages(PDF_PATH)
_buffer = []
_closed = False


class _Tee:
    """Prints to the terminal and stores the text at the same time"""
    def __init__(self, original):
        self.original = original

    def write(self, text):
        self.original.write(text)
        _buffer.append(text)

    def flush(self):
        self.original.flush()

    def __getattr__(self, name):  # forward anything else (encoding, isatty, ...)
        return getattr(self.original, name)


sys.stdout = _Tee(sys.stdout)


def _flush_text(lines_per_page=70, width=200):
    text = "".join(_buffer)
    _buffer.clear()
    if not text.strip():
        return
    lines = []
    for line in text.split("\n"):
        lines.extend(textwrap.wrap(line, width=width, drop_whitespace=False) or [""])
    for i in range(0, len(lines), lines_per_page):
        fig = plt.figure(figsize=(11.69, 8.27))  # A4 landscape
        fig.text(0.03, 0.97, "\n".join(lines[i:i + lines_per_page]),
                 family="monospace", fontsize=6, va="top", ha="left")
        _pdf.savefig(fig)
        plt.close(fig)


def _show(*args, **kwargs):
    _flush_text()  # dump any text printed before this plot
    for num in plt.get_fignums():
        _pdf.savefig(plt.figure(num), bbox_inches="tight")
    plt.close("all")


plt.show = _show


def _finalize():
    global _closed
    if _closed:  # safe to call more than once
        return
    _closed = True
    _flush_text()
    _pdf.close()
    sys.__stdout__.write(f"\nPDF saved to: {PDF_PATH}\n")


atexit.register(_finalize)  # backup in case the script crashes midway
