# Mutual information: detects some nonlinear relationships, exploratory only
print("\n=== 10. MUTUAL INFORMATION (OPTIONAL) ===")
from sklearn.feature_selection import mutual_info_regression, mutual_info_classif
from sklearn.preprocessing import OrdinalEncoder
def mutual_info_ranking(data, target):
    X = data.drop(columns=[target]).copy()
    # Potential post-outcome leakage for cancellation prediction
    if target == "IsCanceled":
        leak = [c for c in ["ReservationStatus", "ReservationStatusDate"] if c in X]
        X = X.drop(columns=leak)
        if leak: print("Excluded likely leakage fields for IsCanceled MI:", leak)
    cat = X.select_dtypes(include=["object","category","bool"]).columns.tolist()
    for c in cat:
        X[c] = X[c].astype("string").fillna("<MISSING>")
    if cat:
        X[cat] = OrdinalEncoder(handle_unknown="use_encoded_value", unknown_value=-1).fit_transform(X[cat].astype(str))
    X = X.replace([np.inf,-np.inf], np.nan)
    for c in X:
        X[c] = X[c].fillna(X[c].median())
    if len(X) > 20000:
        X = X.sample(20000, random_state=42)
    y = data.loc[X.index, target]
    good = y.notna()
    X, y = X.loc[good], y.loc[good]
    discrete = [X[c].nunique() < 15 for c in X.columns]
    if target == "IsCanceled":
        score = mutual_info_classif(X, y.astype(int), discrete_features=discrete, random_state=42)
    else:
        score = mutual_info_regression(X, y.astype(float), discrete_features=discrete, random_state=42)
    return pd.Series(score, index=X.columns).sort_values(ascending=False)
